{
  "name": "gex-browser-enterprise",
  "version": "1.0.69",
  "description": "Navegador Corporativo Seguro com Proxy Integrado",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "keywords": [
    "proxy",
    "secure",
    "browser"
  ],
  "author": "Gex Enterprise",
  "license": "Private",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "node-machine-id": "^1.1.12"
  },
  "build": {
    "appId": "com.gexbrowser.enterprise",
    "productName": "GexBrowser",
    "win": {
      "target": "dir",
      "icon": "icon.ico"
    },
    "files": [
      "**/*",
      "!**/*.py",
      "!venv",
      "!*.spec",
      "!dist_build",
      "!userData",
      "!setup.py",
      "!zip_helper.py"
    ],
    "extraResources": [
      "autologin.js",
      "Iniciar_GexBrowser.bat"
    ]
  }
}
